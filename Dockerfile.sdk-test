ARG BUN_VERSION=1.4.2
FROM node:22-bookworm-slim AS node-runtime
FROM node:20-bookworm-slim AS node20-runtime
FROM denoland/deno:2.9.6 AS deno-runtime
FROM oven/bun:${BUN_VERSION} AS worktree
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY tsconfig.json tsconfig.test.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json .gitignore ./
COPY src ./src
COPY sdk ./sdk
COPY scripts ./scripts
COPY test ./test
COPY docs ./docs
COPY .github/workflows ./.github/workflows

FROM worktree AS typescript-sdk
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node20-runtime /usr/local/bin/node /usr/local/bin/node20
COPY --from=deno-runtime /usr/bin/deno /usr/local/bin/deno
RUN cd sdk/typescript && bun install --frozen-lockfile
RUN cd sdk/typescript/tests/workers && bun install --frozen-lockfile

FROM python:3.13-bookworm AS python-sdk
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=worktree /usr/local/bin/bun /usr/local/bin/bun
COPY --from=worktree /workspace /workspace
WORKDIR /workspace
RUN pip install --no-cache-dir build hatchling \
    && pip install --no-cache-dir -e 'sdk/python[test]'

FROM composer:2 AS composer
FROM php:8.4-cli-bookworm AS php-sdk
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git openssl unzip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY --from=worktree /usr/local/bin/bun /usr/local/bin/bun
COPY --from=worktree /workspace /workspace
WORKDIR /workspace/sdk/php
RUN composer install --no-interaction --no-progress
WORKDIR /workspace

FROM golang:1.26.5-bookworm AS go-sdk
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=worktree /usr/local/bin/bun /usr/local/bin/bun
COPY --from=worktree /workspace /workspace
WORKDIR /workspace/sdk/go
RUN go mod download
RUN cd /workspace/sdk/conformance/drivers/go && go build -o ../go-driver .
WORKDIR /workspace

FROM rust:1.85.0-bookworm AS rust-sdk
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add clippy rustfmt
COPY --from=worktree /usr/local/bin/bun /usr/local/bin/bun
COPY --from=worktree /workspace /workspace
WORKDIR /workspace/sdk/rust
RUN cargo fetch --locked
WORKDIR /workspace

FROM elixir:1.20.1-otp-28-slim AS elixir-sdk
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=worktree /usr/local/bin/bun /usr/local/bin/bun
COPY --from=worktree /workspace /workspace
WORKDIR /workspace/sdk/elixir
RUN mix local.hex --force && mix local.rebar --force && mix deps.get \
    && mix deps.compile && mix compile --warnings-as-errors
WORKDIR /workspace
