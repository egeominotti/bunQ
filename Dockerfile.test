# Reproducible, disposable test environment. This image is intentionally
# separate from the production image: it contains source, tests, and tooling.
ARG BUN_VERSION=1.4.0
FROM oven/bun:${BUN_VERSION}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
RUN chown bun:bun /workspace

COPY --chown=bun:bun package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile --ignore-scripts

COPY --chown=bun:bun tsconfig.json tsconfig.test.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json ./
COPY --chown=bun:bun Dockerfile.test ./
COPY --chown=bun:bun src ./src
COPY --chown=bun:bun test ./test
COPY --chown=bun:bun examples/postgres-multibroker ./examples/postgres-multibroker
COPY --chown=bun:bun scripts ./scripts
COPY --chown=bun:bun bench ./bench
COPY --chown=bun:bun monitoring ./monitoring
COPY --chown=bun:bun docker-compose.yml ./
COPY --chown=bun:bun docker-compose.postgres.yml ./
COPY --chown=bun:bun docs/*.md ./docs/
COPY --chown=bun:bun docs/benchmarks ./docs/benchmarks
COPY --chown=bun:bun docs/features ./docs/features
COPY --chown=bun:bun docs/src/content/docs ./docs/src/content/docs
COPY --chown=bun:bun docs/src/components/examples ./docs/src/components/examples
COPY --chown=bun:bun docs/src/lib/llms-full.ts ./docs/src/lib/llms-full.ts
COPY --chown=bun:bun docs/vercel.json ./docs/vercel.json
COPY --chown=bun:bun .github/workflows/ci.yml ./.github/workflows/ci.yml
COPY --chown=bun:bun .github/workflows/sdk.yml ./.github/workflows/sdk.yml
COPY --chown=bun:bun .github/workflows/sdk-release.yml ./.github/workflows/sdk-release.yml
COPY --chown=bun:bun .github/workflows/sdk-security.yml ./.github/workflows/sdk-security.yml
COPY --chown=bun:bun .github/workflows/sdk-mutation.yml ./.github/workflows/sdk-mutation.yml
COPY --chown=bun:bun sdk/conformance/harness.ts sdk/conformance/process-lifecycle.ts sdk/conformance/wire.ts ./sdk/conformance/
COPY --chown=bun:bun sdk/typescript/package.json ./sdk/typescript/
COPY --chown=bun:bun sdk/typescript/tests/harness.ts sdk/typescript/tests/e2e-edge.ts ./sdk/typescript/tests/
COPY --chown=bun:bun sdk/typescript/tests/workers/run.mjs ./sdk/typescript/tests/workers/run.mjs
COPY --chown=bun:bun sdk/python/pyproject.toml ./sdk/python/pyproject.toml
COPY --chown=bun:bun sdk/php/infection.json5 ./sdk/php/infection.json5
COPY --chown=bun:bun sdk/php/src/Flow/SnapshotValidator.php ./sdk/php/src/Flow/SnapshotValidator.php
COPY --chown=bun:bun sdk/go/.gremlins.yaml ./sdk/go/.gremlins.yaml
COPY --chown=bun:bun sdk/rust/.cargo/mutants.toml ./sdk/rust/.cargo/mutants.toml
COPY --chown=bun:bun sdk/elixir/mix.exs ./sdk/elixir/mix.exs

ENV CI=1 \
    HOME=/tmp \
    LANG=C.UTF-8 \
    NODE_ENV=test \
    TMPDIR=/tmp \
    TZ=UTC

USER bun
CMD ["bun", "test"]
