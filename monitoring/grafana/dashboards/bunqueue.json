      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Service & queue overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "up{job=\"bunqueue\"}", "refId": "A" }],
      "title": "Server",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "HEALTHY" }, "1": { "color": "red", "text": "DEGRADED" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_storage_degraded", "refId": "A" }],
      "title": "Storage",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 10000 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_jobs_waiting + bunqueue_jobs_prioritized", "refId": "A" }],
      "title": "Ready backlog",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_jobs_dlq", "refId": "A" }],
      "title": "DLQ",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_worker_active_jobs / clamp_min(bunqueue_worker_concurrency_slots, 1)", "refId": "A" }],
      "title": "Worker utilization",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "count(ALERTS{alertname=~\"Bunqueue.*\",alertstate=\"firing\"}) or on() vector(0)", "refId": "A" }],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "Throughput & queue state",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "rate(bunqueue_jobs_pushed_total[$__rate_interval])", "legendFormat": "Pushed/s", "refId": "A" },
        { "expr": "rate(bunqueue_jobs_pulled_total[$__rate_interval])", "legendFormat": "Pulled/s", "refId": "B" },
        { "expr": "rate(bunqueue_jobs_completed_total[$__rate_interval])", "legendFormat": "Completed/s", "refId": "C" },
        { "expr": "rate(bunqueue_jobs_failed_total[$__rate_interval])", "legendFormat": "Failed/s", "refId": "D" }
      ],
      "title": "Job throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "bunqueue_jobs_waiting", "legendFormat": "Waiting", "refId": "A" },
        { "expr": "bunqueue_jobs_prioritized", "legendFormat": "Prioritized", "refId": "B" },
        { "expr": "bunqueue_jobs_delayed", "legendFormat": "Delayed", "refId": "C" },
        { "expr": "bunqueue_jobs_active", "legendFormat": "Active", "refId": "D" },
        { "expr": "bunqueue_jobs_dlq", "legendFormat": "DLQ", "refId": "E" }
      ],
      "title": "Global queue state",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "bunqueue_queue_jobs_waiting{queue=~\"$queue\"}", "legendFormat": "{{queue}} waiting", "refId": "A" },
        { "expr": "bunqueue_queue_jobs_prioritized{queue=~\"$queue\"}", "legendFormat": "{{queue}} prioritized", "refId": "B" },
        { "expr": "bunqueue_queue_jobs_delayed{queue=~\"$queue\"}", "legendFormat": "{{queue}} delayed", "refId": "C" },
        { "expr": "bunqueue_queue_jobs_active{queue=~\"$queue\"}", "legendFormat": "{{queue}} active", "refId": "D" },
        { "expr": "bunqueue_queue_jobs_dlq{queue=~\"$queue\"}", "legendFormat": "{{queue}} DLQ", "refId": "E" }
      ],
      "title": "Per-queue state",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "panels": [],
      "title": "Latency (seconds)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 20,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(bunqueue_push_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Push p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(bunqueue_push_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Push p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(bunqueue_push_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Push p99", "refId": "C" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(bunqueue_pull_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Pull p50", "refId": "D" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(bunqueue_pull_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Pull p95", "refId": "E" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(bunqueue_pull_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Pull p99", "refId": "F" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(bunqueue_ack_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Ack p50", "refId": "G" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(bunqueue_ack_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Ack p95", "refId": "H" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(bunqueue_ack_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "Ack p99", "refId": "I" }
      ],
      "title": "Latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 21,
      "options": { "calculate": false, "cellGap": 1, "color": { "exponent": 0.5, "mode": "scheme", "scheme": "Spectral" }, "filterValues": { "le": 0.000001 }, "legend": { "show": true } },
      "targets": [
        {
          "expr": "sum by (le) (rate(bunqueue_push_duration_seconds_bucket[$__rate_interval]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
