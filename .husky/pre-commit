#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Type check
echo "📘 TypeScript check..."
bun run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Commit aborted."
  exit 1
fi

# Lint + format (Biome, one pass)
echo "🔎 Biome check (lint + format)..."
bun run check:biome
if [ $? -ne 0 ]; then
  echo "❌ Biome errors found. Run 'bun run lint:fix && bun run format' to fix."
  exit 1
fi

echo "✅ All checks passed!"
