        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(bunqueue_queue_jobs_waiting, queue)",
        "hide": 0,
        "includeAll": true,
        "label": "Queue",
        "multi": true,
        "name": "queue",
        "options": [],
        "query": { "query": "label_values(bunqueue_queue_jobs_waiting, queue)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
