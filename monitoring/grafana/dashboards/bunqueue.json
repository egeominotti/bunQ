    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 33,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true } },
