---
import Default from '@astrojs/starlight/components/Head.astro';
import { lastmodForId } from '../lib/gitLastmod';

/**
 * Extends Starlight's Head with structured data Starlight cannot emit
 * per-route on its own:
 *  - BlogPosting JSON-LD on every /blog/ post (headline, dates, author)
 *  - TechArticle JSON-LD on every guide/reference/architecture page
 *  - BreadcrumbList JSON-LD on every page below the homepage
 */
const SITE = 'https://bunqueue.dev';
const { entry, id } = Astro.locals.starlightRoute;

const canonical = new URL(Astro.url.pathname, SITE).href;
const heads = entry.data.head ?? [];
const headContent = (property) =>
  heads.find((h) => h.attrs?.property === property)?.attrs?.content;

const scripts = [];

const isBlogPost = id.startsWith('blog/') && id !== 'blog';
if (isBlogPost) {
  const published = headContent('article:published_time');
  scripts.push({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    image: headContent('og:image') ?? `${SITE}/og-image.png`,
    ...(published ? { datePublished: published, dateModified: published } : {}),
    author: {
      '@type': 'Person',
      name: 'Egeo Minotti',
      url: 'https://github.com/egeominotti',
    },
    publisher: { '@type': 'Person', name: 'Egeo Minotti' },
  });
}

// TechArticle on the technical pages (guides, API reference, architecture,
// and the reference root pages). Excludes blog posts (they get BlogPosting),
// the homepage splash (site-wide SoftwareApplication already covers it) and
// the 404. dateModified comes from real git history, never a build-time now().
const isTechArticle =
  !isBlogPost && id !== 'blog' && id !== '' && id !== 'index' && id !== '404';
if (isTechArticle) {
  const lastmod = lastmodForId(id);
  scripts.push({
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: entry.data.title,
    description: entry.data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    image: headContent('og:image') ?? `${SITE}/og-image.png`,
    inLanguage: 'en',
    ...(lastmod ? { dateModified: lastmod } : {}),
    author: {
      '@type': 'Person',
      name: 'Egeo Minotti',
      url: 'https://github.com/egeominotti',
    },
    publisher: {
      '@type': 'Organization',
      name: 'bunqueue',
      logo: { '@type': 'ImageObject', url: `${SITE}/apple-touch-icon.png` },
    },
  });
}

// FAQPage auto-generated from the FAQ page's own H3 sections, so the schema
// never drifts from the visible questions. Only real questions are marked up:
// headings ending in '?' plus quoted error-string headings. The answer is the
// prose up to the next heading, stripped of markdown to clean text.
if (id === 'faq') {
  const stripped = (entry.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/:::[\s\S]*?:::/g, ' ')
    .replace(/`([^`]+)`/g, '$1');
  const faqs = [];
  for (const sec of stripped.split(/\n(?=### )/)) {
    const m = sec.match(/^###\s+(.+?)\s*\n([\s\S]*)$/);
    if (!m) continue;
    const raw = m[1].trim();
    const isQuestion = raw.endsWith('?') || /^["“].*["”]$/.test(raw);
    if (!isQuestion) continue;
    const name = raw.replace(/^["“](.*)["”]$/, '$1');
    // terminate the answer at the next H2 OR a Starlight ::: directive (asides
    // like :::tip[Related] must never bleed into the structured-data answer)
    let text = (m[2].split(/\n## |\n:::/)[0] ?? '')
      .replace(/^\s*\|.*\|\s*$/gm, ' ')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*>#]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
    if (!text) continue;
    if (text.length > 700) text = `${text.slice(0, 697).trimEnd()}...`;
    faqs.push({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } });
  }
  if (faqs.length) {
    scripts.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs });
  }
}

const segments = Astro.url.pathname.split('/').filter(Boolean);
if (segments.length > 0) {
  const labels = {
    guide: 'Guide',
    api: 'API Reference',
    architecture: 'Architecture',
    blog: 'Blog',
  };
  // Sections with a real index page; /guide/ and /api/ have none, so an
  // intermediate crumb for them would link to a 404 — skip those instead.
  const sectionIndexExists = new Set(['architecture', 'blog']);
  const items = [{ '@type': 'ListItem', position: 1, name: 'bunqueue', item: `${SITE}/` }];
  let path = '';
  segments.forEach((segment, i) => {
    path += `/${segment}`;
    const last = i === segments.length - 1;
    if (!last && !sectionIndexExists.has(segment)) return;
    items.push({
      '@type': 'ListItem',
      position: items.length + 1,
      name: last ? entry.data.title : (labels[segment] ?? segment),
      ...(last ? {} : { item: `${SITE}${path}/` }),
    });
  });
  scripts.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items,
  });
}
---

<Default><slot /></Default>
<link rel="alternate" type="application/rss+xml" title="bunqueue blog" href="/rss.xml" />
{
  scripts.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  ))
}
