{
  "name": "bunqueue",
  "version": "2.8.49",
  "description": "High-performance job queue for Bun & AI agents. SQLite persistence, cron scheduling, priorities, retries, DLQ, webhooks, native MCP server. Zero external infrastructure.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "bunqueue": "./dist/cli/index.js",
    "bunqueue-mcp": "./dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "bun": "./dist/main.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "bun": "./dist/client/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/client/index.js"
    },
    "./queue": {
      "types": "./dist/application/queueManager.d.ts",
      "bun": "./dist/application/queueManager.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/application/queueManager.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "bun": "./dist/mcp/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/mcp/index.js"
    },
    "./workflow": {
      "types": "./dist/client/workflow/index.d.ts",
      "bun": "./dist/client/workflow/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/client/workflow/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/bunqueue",
    "!dist/benchmark",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build --compile --minify src/main.ts --outfile dist/bunqueue",
    "build:lib": "tsc -p tsconfig.build.json",
    "docs:api": "bun run scripts/build-api-reference.ts",
    "check:docs-data": "bun run scripts/check-docs-data.ts",
    "test": "BUNQUEUE_EMBEDDED=1 bun test",
    "test:model": "BUNQUEUE_EMBEDDED=1 bun test test/model-based/queue-model.test.ts test/model-based/workflow-model.test.ts test/model-based/backup-model.test.ts test/model-based/monitoring-model.test.ts test/model-based/enterprise-telemetry-model.test.ts",
    "test:sandbox": "bun run scripts/test-sandbox.ts",
    "test:sandbox:sdk": "bun run scripts/test-sdk-sandbox.ts",
    "bench": "bun run bench/comprehensive.ts",
    "bench:tcp": "bun run bench/tcp-bench.ts",
    "bench:autobatch": "bun run bench/local-autobatch.ts",
    "bench:pushbulk": "bun run bench/pushbulk-delta.ts",
    "bench:joblist": "bun run bench/job-list-perf.ts",
    "bench:compare": "bun run bench/comparison/run.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "check:biome": "biome check src",
    "check": "bun run typecheck && biome check src && bun run check:docs-data",
    "prepublishOnly": "bun run build:lib"
  },
  "dependencies": {
    "croner": "10.0.1",
    "msgpackr": "^1.11.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.22",
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@biomejs/biome": "2.5.1",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@mastra/core": "^1.53.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@openai/agents": "^0.13.5",
    "@types/bun": "^1.3.9",
    "ai": "^7.0.38",
    "bullmq": "^5.79.3",
    "elysia": "^1.4.25",
    "fast-check": "^4.9.0",
    "ioredis": "^5.11.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "bun",
    "job-queue",
    "message-queue",
    "task-queue",
    "background-jobs",
    "queue",
    "worker",
    "cron",
    "scheduler",
    "sqlite",
    "redis-alternative",
    "bullmq-alternative",
    "priority-queue",
    "delayed-jobs",
    "retries",
    "dead-letter-queue",
    "dlq",
    "webhooks",
    "prometheus",
    "typescript",
    "ai",
    "ai-agent",
    "ai-native",
    "mcp",
    "model-context-protocol",
    "agentic",
    "automation",
    "workflow",
    "workflow-engine",
    "orchestration",
    "saga",
    "saga-pattern",
    "temporal-alternative",
    "inngest-alternative",
    "step-functions",
    "multi-step",
    "compensation",
    "human-in-the-loop"
  ],
  "author": "egeominotti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeominotti/bunqueue.git"
  },
  "bugs": {
    "url": "https://github.com/egeominotti/bunqueue/issues"
  },
  "homepage": "https://bunqueue.dev",
  "engines": {
    "bun": ">=1.3.9"
  }
}
