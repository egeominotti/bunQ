{
  "name": "bunqueue",
  "version": "2.8.19",
  "description": "High-performance job queue for Bun & AI agents. SQLite persistence, cron scheduling, priorities, retries, DLQ, webhooks, native MCP server. Zero external dependencies.",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "bunqueue": "./dist/cli/index.js",
    "bunqueue-mcp": "./dist/mcp/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "bun": "./dist/main.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/main.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "bun": "./dist/client/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/client/index.js"
    },
    "./queue": {
      "types": "./dist/application/queueManager.d.ts",
      "bun": "./dist/application/queueManager.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/application/queueManager.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "bun": "./dist/mcp/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/mcp/index.js"
    },
    "./workflow": {
      "types": "./dist/client/workflow/index.d.ts",
      "bun": "./dist/client/workflow/index.js",
      "node": "./dist/bun-only.js",
      "import": "./dist/client/workflow/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/bunqueue",
    "!dist/benchmark",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .husky",
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "build": "bun build --compile --minify src/main.ts --outfile dist/bunqueue",
    "build:lib": "tsc -p tsconfig.build.json",
    "test": "BUNQUEUE_EMBEDDED=1 bun test",
    "bench": "bun run bench/throughput.ts && bun run bench/latency.ts",
    "bench:throughput": "bun run bench/throughput.ts",
    "bench:latency": "bun run bench/latency.ts",
    "bench:internal": "bun run benchmarks/index.ts",
    "bench:compare": "bun run bench/comparison/run.ts",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "check:biome": "biome check src",
    "check": "bun run typecheck && biome check src",
    "prepublishOnly": "bun run build:lib"
  },
  "dependencies": {
    "croner": "10.0.1",
    "msgpackr": "^1.11.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/bun": "^1.3.9",
    "bullmq": "^5.70.1",
    "elysia": "^1.4.25",
    "ioredis": "^5.9.3",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "keywords": [
    "bun",
    "job-queue",
    "message-queue",
    "task-queue",
    "background-jobs",
    "queue",
    "worker",
    "cron",
    "scheduler",
    "sqlite",
    "redis-alternative",
    "bullmq-alternative",
    "priority-queue",
    "delayed-jobs",
    "retries",
    "dead-letter-queue",
    "dlq",
    "webhooks",
    "prometheus",
    "typescript",
    "ai",
    "ai-agent",
    "ai-native",
    "mcp",
    "model-context-protocol",
    "agentic",
    "automation",
    "workflow",
    "workflow-engine",
    "orchestration",
    "saga",
    "saga-pattern",
    "temporal-alternative",
    "inngest-alternative",
    "step-functions",
    "multi-step",
    "compensation",
    "human-in-the-loop"
  ],
  "author": "egeominotti",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egeominotti/bunqueue.git"
  },
  "bugs": {
    "url": "https://github.com/egeominotti/bunqueue/issues"
  },
  "homepage": "https://bunqueue.dev",
  "engines": {
    "bun": ">=1.3.9"
  }
}
