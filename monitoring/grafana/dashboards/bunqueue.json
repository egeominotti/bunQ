      "id": 41,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_backup_scheduler_running", "refId": "A" }],
      "title": "Backup scheduler",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 49 },
      "id": 42,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [{ "expr": "bunqueue_backup_consecutive_failures", "refId": "A" }],
      "title": "Backup failures",
      "type": "stat"
    },
