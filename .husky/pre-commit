#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Type check
echo "📘 TypeScript check..."
bun run typecheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Commit aborted."
  exit 1
fi

# Lint and format verification (Oxlint + Oxfmt)
echo "🔎 Oxlint and Oxfmt check..."
bun run check:oxc
if [ $? -ne 0 ]; then
  echo "❌ Lint or format errors found. Run 'bun run lint:fix && bun run format' to fix."
  exit 1
fi

echo "✅ All checks passed!"
