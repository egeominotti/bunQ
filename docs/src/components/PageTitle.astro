---
import DocsContext from './DocsContext.astro';
/**
 * Starlight renders the frontmatter title as the page <h1>. On the 81 pages
 * that open with a custom .bq-hero, custom.css hides the panel that contains
 * it (`main:has(.bq-hero) .content-panel:first-of-type { display: none }`) and
 * the hero supplies its own visible <h1> — which left every one of those pages
 * with two <h1> elements, the keyword-bearing one inside a display:none
 * subtree that search engines discount anyway.
 *
 * So: keep the real <h1> on pages that actually display it, and downgrade it
 * to a plain <div> where the hero already owns the heading. MarkdownContent
 * provides the visible #_top focus target for those pages so skip links and
 * the table of contents never target this hidden panel.
 */
// Starlight's PAGE_TITLE_ID, inlined: `constants.ts` is not in the package's
// export map, and the value is a public contract (the TOC links to #_top).
const PAGE_TITLE_ID = '_top';

const { entry, id, hasSidebar } = Astro.locals.starlightRoute;
const heroOwnsTheHeading = id === 'index' || id === '' || (entry.body ?? '').includes('bq-hero');
---

{hasSidebar && !heroOwnsTheHeading && <DocsContext />}

{
  heroOwnsTheHeading ? (
    <div class="sl-page-title">
      {entry.data.title}
    </div>
  ) : (
    <h1 id={PAGE_TITLE_ID} class="sl-page-title">
      {entry.data.title}
    </h1>
  )
}

<style>
  @layer starlight.core {
    .sl-page-title {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }
</style>
