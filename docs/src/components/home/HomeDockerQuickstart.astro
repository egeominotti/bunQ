---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

const variants = [
  { label: 'Alpine', tag: 'alpine', description: 'The default: a compact musl base with a shell and apk.' },
  { label: 'Debian', tag: 'debian', description: 'A full Debian base with glibc, a shell and apt.' },
  { label: 'Slim', tag: 'slim', description: 'Debian with glibc, a shell and apt, with fewer bundled utilities.' },
  { label: 'Distroless', tag: 'distroless', description: 'Required runtime libraries only. No shell or package manager.' },
];
const command = (tag: string) => `docker run -d --name bunqueue \\
  --restart unless-stopped \\
  -p 127.0.0.1:6789:6789 \\
  -p 127.0.0.1:6790:6790 \\
  -v bunqueue-data:/app/data \\
  egeominotti/bunqueue:${tag}`;
---

<div class="home-docker-quickstart">
  <p>With Docker running, choose a base and copy the command. No Bun installation needed.</p>
  <Tabs>
    {variants.map(({ label, tag, description }) => (
      <TabItem label={label}>
        <p class="home-note">{description} Same bunqueue features on AMD64 and ARM64.</p>
        <Code code={command(tag)} lang="bash" />
      </TabItem>
    ))}
  </Tabs>
  <p>Check that the server is ready:</p>
  <Code code="curl --fail http://127.0.0.1:6790/health" lang="bash" />
  <dl class="home-connection">
    <div><dt>Client connection</dt><dd>127.0.0.1:6789 <span>TCP</span></dd></div>
    <div><dt>HTTP API</dt><dd>127.0.0.1:6790 <span>HTTP</span></dd></div>
    <div><dt>Storage</dt><dd>bunqueue-data <span>Docker volume</span></dd></div>
  </dl>
  <p class="home-note">Ports stay local to your machine. SQLite data persists in the volume when you replace the container. Run one variant at a time.</p>
  <p class="home-note">These tags follow new releases. Pin a version or digest for deployment.</p>
</div>

<style>
  .home-docker-quickstart { min-width: 0; }
  @media (max-width: 480px) {
    .home-docker-quickstart :global([role='tablist']) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
  }
</style>
