---
import Default from '@astrojs/starlight/components/Footer.astro';

/**
 * Keeps Starlight's footer (edit link, last updated, pagination) and
 * appends the site-wide footer: brand, link columns, legal line.
 */
const year = new Date().getFullYear();
---

<Default><slot /></Default>

<footer class="bq-footer">
  <div class="bq-footer-grid">
    <div class="bq-footer-brand">
      <svg
        class="bq-footer-logo"
        width="34"
        height="34"
        viewBox="0 0 48 48"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          <linearGradient id="bqFooterMark" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff4f9f"></stop>
            <stop offset="1" stop-color="#d3156d"></stop>
          </linearGradient>
        </defs>
        <rect width="48" height="48" rx="11" fill="url(#bqFooterMark)"></rect>
        <g transform="translate(8,8) scale(0.6667)">
          <g
            fill="none"
            stroke="#fff"
            stroke-width="4.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="13" y="8" width="20" height="20" rx="6.6"></rect>
            <path d="M31 26V39.5"></path>
          </g>
          <circle cx="31" cy="40" r="4" fill="#fff"></circle>
        </g>
      </svg>
      <p class="bq-footer-name">bunqueue</p>
      <p class="bq-footer-tag">The queue is a file. Zero-infrastructure background jobs, persisted to SQLite.</p>
    </div>
    <nav aria-label="Product">
      <p>Product</p>
      <a href="/guide/quickstart/">Quickstart</a>
      <a href="/guide/benchmarks/">Benchmarks</a>
      <a href="/guide/comparison/">vs BullMQ</a>
      <a href="/simulator/">Simulator</a>
      <a href="/changelog/">Changelog</a>
    </nav>
    <nav aria-label="Documentation">
      <p>Docs</p>
      <a href="/guide/queue/">Queue</a>
      <a href="/guide/worker/">Worker</a>
      <a href="/guide/workflow/">Workflow engine</a>
      <a href="/guide/server/">Server mode</a>
      <a href="/api/http/">API reference</a>
    </nav>
    <nav aria-label="Community">
      <p>Community</p>
      <a href="https://github.com/egeominotti/bunqueue">GitHub</a>
      <a href="https://github.com/egeominotti/bunqueue/discussions">Discussions</a>
      <a href="/contributing/">Contributing</a>
      <a href="https://www.npmjs.com/package/bunqueue">npm</a>
      <a href="https://x.com/bunqueue">X</a>
      <a href="/blog/">Blog</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
  <p class="bq-footer-legal">MIT licensed · © {year} Egeo Minotti · bunqueue.dev</p>
</footer>

<style>
  .bq-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--bq-line, var(--sl-color-hairline));
    padding: 2.6rem 0 2rem;
    font-family: var(--bq-mono, ui-monospace, monospace);
  }

  .bq-footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  .bq-footer-logo {
    display: block;
    width: 34px;
    height: 34px;
  }

  .bq-footer-name {
    font-family: var(--bq-display, inherit);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--sl-color-white);
    margin: 0.7rem 0 0.3rem;
  }

  .bq-footer-tag {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    margin: 0;
    max-width: 26rem;
  }

  .bq-footer nav {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .bq-footer nav p {
    font-size: 0.72rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.25rem;
  }

  .bq-footer nav a {
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    width: fit-content;
  }

  .bq-footer nav a:hover {
    color: var(--sl-color-white);
  }

  .bq-footer-legal {
    margin: 2.2rem 0 0;
    padding-top: 1.2rem;
    border-top: 1px solid var(--bq-line, var(--sl-color-hairline));
    font-size: 0.76rem;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 50rem) {
    .bq-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bq-footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* The phone layer in custom.css zeroes the content panel's inline padding so
     cards and code blocks can run edge to edge. This footer relies on that
     panel for its gutter, so below that breakpoint it needs its own or the
     logo, the link columns and the legal line sit 3px from the screen edge. */
  @media (max-width: 38rem) {
    .bq-footer {
      padding-inline: 1rem;
    }
  }
</style>
